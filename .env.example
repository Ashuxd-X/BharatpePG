# bharatpe-payment-plugin — environment variables
# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).

# ── Required ────────────────────────────────────────────────────────────────
BOT_TOKEN=123456:ABC-your-token-from-botfather   # from @BotFather
UPI_ID=yourname@yesbankltd                        # your UPI VPA, encoded into the QR
MERCHANT_NAME=My Store                            # shown on the QR card
ADMIN_IDS=123456789                               # Telegram user ID(s), comma-separated (from @userinfobot)

# ── Optional: merchant ID ───────────────────────────────────────────────────
# Usually NOT needed — BharatPe scopes transactions by your /login token.
# BharatPe doesn't show a merchant ID in the app/website; leave this blank
# unless you specifically need to pin one brand/store.
MERCHANT_ID=

# ── Optional: storage ───────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the zero-setup sqlite file store (default).
# Set it to a Postgres DSN to opt into Postgres instead.
DATABASE_URL=
DB_PATH=payments.db                               # sqlite file path (used when DATABASE_URL is empty)
